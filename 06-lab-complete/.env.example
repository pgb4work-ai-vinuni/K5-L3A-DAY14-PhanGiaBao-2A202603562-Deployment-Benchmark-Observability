# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# (.env đã nằm trong .gitignore — KHÔNG commit file .env)
PORT=8000
ENVIRONMENT=development
AGENT_API_KEY=change-me-to-a-long-random-string
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
LOG_LEVEL=INFO
